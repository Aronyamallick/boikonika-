# Settings for infrastructure/docker-compose.yml. Copy to infrastructure/.env and fill in every secret.
# Never commit the filled-in file.

# Public address of the site (the API is served from the same origin under /api).
SITE_URL=https://boikonika.com
HTTP_PORT=80
# "off" keeps search engines away (staging).
SEARCH_INDEXING=on

POSTGRES_USER=boikonika
POSTGRES_PASSWORD=
POSTGRES_DB=boikonika

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Must stay true in production (the site is served over HTTPS).
COOKIE_SECURE=true

# Uploads: "local" keeps them on the uploads volume. For S3 / Cloudflare R2 set "s3" and the values
# below; S3_ENDPOINT must be reachable from browsers (private files are shared as signed links).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=boikonika-public
S3_BUCKET_PRIVATE=boikonika-private
# Public address of the public bucket or its CDN, e.g. https://media.boikonika.com
S3_PUBLIC_BASE_URL=

# First super admin, created by the migrate job if no admin exists yet.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email is required in production (sign-up codes, receipts). Port 587 with STARTTLS, or 465 with SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Boikonika <no-reply@boikonika.com>

# Optional integrations (leave empty to disable) — see docs/integrations.md.
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
GOOGLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EXPO_ACCESS_TOKEN=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
ANTHROPIC_API_KEY=
