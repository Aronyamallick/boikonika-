# Boikonika web — copy to web/.env.local for local development.
# These are read at build time (inlined into the browser bundle) AND when the server starts
# (image optimisation allow-list), so set the same values in both environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin of uploaded media when it differs from the API (CDN / S3 public bucket).
NEXT_PUBLIC_ASSETS_URL=
# Server-side requests can use a private address (e.g. http://backend:4000 inside Docker).
API_INTERNAL_URL=http://localhost:4000
# Set to "off" on staging and preview sites so robots.txt keeps search engines out.
SEARCH_INDEXING=
