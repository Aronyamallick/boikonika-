{
  "name": "@boikonika/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), migrations and seed data for Boikonika",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate.js",
    "migrate:test": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://boikonika:boikonika_dev_pw@127.0.0.1:5432/boikonika_test} node dist/migrate.js",
    "seed": "node dist/seed/index.js",
    "seed:demo": "node dist/seed/index.js --demo",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@boikonika/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
