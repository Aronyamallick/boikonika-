# Boikonika API — copy to backend/.env for local development.
# Production: set these as real environment variables (never commit secrets).
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
# SWAGGER_ENABLED defaults to true outside production.

# PostgreSQL 16+ (required)
DATABASE_URL=postgres://boikonika:boikonika_dev_pw@127.0.0.1:5432/boikonika_dev
DATABASE_POOL_MAX=20
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-48-byte-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
# 32-byte key, base64 — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# File storage: local (development) or s3 (any S3-compatible service: AWS S3, Cloudflare R2, MinIO, Wasabi)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=boikonika-public
S3_BUCKET_PRIVATE=boikonika-private
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Email: log (prints to the console) or smtp
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Boikonika <no-reply@boikonika.com>

# SMS: log (prints to the console) or http (generic BD SMS gateway, see docs/integrations.md)
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Google sign-in: comma-separated OAuth client IDs (web, Android, iOS)
GOOGLE_CLIENT_IDS=

# Push notifications (web push VAPID keys: npx web-push generate-vapid-keys) and Expo push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@boikonika.com
EXPO_ACCESS_TOKEN=

# Marketplace
PLATFORM_COMMISSION_PERCENT=10
# PAYMENT_SANDBOX_ENABLED defaults to true outside production (simulated gateway for testing).

# bKash tokenized checkout (merchant credentials from bKash)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# SSLCOMMERZ (cards, internet banking, Nagad, Rocket)
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Optional AI assistants (Claude). Leave empty to disable the AI features.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
