{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "jest"],
    "lib": ["ES2022"]
  },
  "include": ["src", "test", "scripts"]
}
