{
  "name": "@boikonika/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Boikonika REST + WebSocket API (NestJS, PostgreSQL, Redis)",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src/",
    "test:e2e": "jest --runInBand --testPathPattern=test/",
    "openapi": "node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@boikonika/database": "workspace:*",
    "@boikonika/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.8",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.44.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.3",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/test/global-setup.ts"
  }
}
